{
  "name": "juru-vscode",
  "displayName": "JuRu Language (official)",
  "description": "Syntax highlighting, snippets, a run button and a REPL for JuRu (.jr) — the easy, secure programming language.",
  "version": "1.5.0",
  "publisher": "juru-lang",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "./extension.js",
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "juru",
    "beginner",
    "education",
    "jr"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/RaviHackjr/JuRu"
  },
  "contributes": {
    "commands": [
      {
        "command": "juru.runFile",
        "title": "JuRu: Run File",
        "icon": "$(play)"
      },
      {
        "command": "juru.openRepl",
        "title": "JuRu: Open REPL"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "juru.runFile",
          "when": "resourceLangId == juru",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "juru.runFile",
          "when": "resourceLangId == juru"
        }
      ]
    },
    "configuration": {
      "title": "JuRu",
      "properties": {
        "juru.interpreterPath": {
          "type": "string",
          "default": "juru",
          "markdownDescription": "Path to the JuRu interpreter (`juru` on macOS/Linux, `juru.exe` on Windows). Leave it as `juru` when the interpreter is on your PATH. Get it from the [JuRu releases page](https://github.com/RaviHackjr/JuRu/releases/latest)."
        }
      }
    },
    "languages": [
      {
        "id": "juru",
        "aliases": [
          "JuRu",
          "juru"
        ],
        "extensions": [
          ".jr"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "juru",
        "scopeName": "source.juru",
        "path": "./syntaxes/juru.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "juru",
        "path": "./snippets/juru.json"
      }
    ]
  }
}
