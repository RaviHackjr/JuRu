{
  "name": "juru-vscode",
  "displayName": "JuRu Language (official)",
  "description": "Syntax highlighting, snippets, a run button and a REPL for JuRu (.jr) — the easy, secure programming language.",
  "version": "1.11.0",
  "publisher": "juru-lang",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "./extension.js",
  "icon": "images/juru.png",
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "juru",
    "beginner",
    "education",
    "jr"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/RaviHackjr/JuRu"
  },
  "contributes": {
    "commands": [
      {
        "command": "juru.runFile",
        "title": "JuRu: Run File",
        "icon": "$(play)"
      },
      {
        "command": "juru.openRepl",
        "title": "JuRu: Open REPL"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "juru.runFile",
          "when": "resourceLangId == juru",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "juru.runFile",
          "when": "resourceLangId == juru"
        }
      ],
      "explorer/context": [
        {
          "command": "juru.runFile",
          "when": "resourceExtname == .jr"
        }
      ]
    },
    "keybindings": [
      {
        "command": "juru.runFile",
        "key": "ctrl+alt+j",
        "when": "resourceLangId == juru"
      }
    ],
    "configuration": {
      "title": "JuRu",
      "properties": {
        "juru.interpreterPath": {
          "type": "string",
          "default": "auto",
          "markdownDescription": "Leave it as `auto` — the extension finds the interpreter by itself: plain `juru` on your PATH, or the one-step-setup location (`%LOCALAPPDATA%\\Programs\\JuRu` on Windows, `/usr/local/bin` or `~/.local/bin` elsewhere). Only set a full path if you keep the interpreter somewhere unusual. Get it from the [JuRu releases page](https://github.com/RaviHackjr/JuRu/releases/latest)."
        }
      }
    },
    "languages": [
      {
        "id": "juru",
        "aliases": [
          "JuRu",
          "juru"
        ],
        "extensions": [
          ".jr"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/juru-file-icon.png",
          "dark": "./images/juru-file-icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "juru",
        "scopeName": "source.juru",
        "path": "./syntaxes/juru.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "juru",
        "path": "./snippets/juru.json"
      }
    ]
  }
}
