# mega demo — a full school report: grades, sorting, topper, histogram

func grade_of(score) {
    if score >= 90 {
        return "A"
    } else if score >= 80 {
        return "B"
    } else if score >= 70 {
        return "C"
    } else {
        return "D"
    }
}

rows = [
    ["Aarav", 78],
    ["Diya", 76],
    ["Esha", 100],
    ["Kabir", 64],
    ["Ria", 91]
]

say(upper("class report"))

total = 0
for i from 0 to len(rows) - 1 {
    total = total + rows[i][1]
    say(rows[i][0] + " -> " + rows[i][1] + " (grade " + grade_of(rows[i][1]) + ")")
}

average = total / len(rows)
say("class average: " + str(average))

# bubble sort — highest marks first
n = len(rows)
for i from 0 to n - 2 {
    for j from 0 to n - 2 - i {
        if rows[j][1] < rows[j + 1][1] {
            temp = rows[j]
            rows[j] = rows[j + 1]
            rows[j + 1] = temp
        }
    }
}

say("-- ranking --")
for i from 0 to n - 1 {
    say((i + 1) + ". " + rows[i][0] + " " + rows[i][1])
}

topper = rows[0][0]
say("topper: " + topper)
if topper == "Esha" {
    say("gold star for " + upper(topper) + "!")
}

say("-- histogram --")
grades = ["A", "B", "C", "D"]
for g from 0 to len(grades) - 1 {
    total_seen = 0
    for i from 0 to n - 1 {
        if grade_of(rows[i][1]) == grades[g] {
            total_seen = total_seen + 1
        }
    }
    bar = ""
    if total_seen > 0 {
        for k from 1 to total_seen {
            bar = bar + "#"
        }
    }
    say(grades[g] + " | " + bar)
}
